# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > App settings > Secrets.

# Supabase > Project Settings > Database > Connection string > "Session pooler" (IPv4)
DATABASE_URL = "postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Resend: API key + a sender on a domain you verified in Resend
RESEND_API_KEY = "re_xxxxxxxx"
MAIL_FROM = "Easy Job Finder <alerts@yourdomain.org>"

# Public URL of this app (used for confirm / unsubscribe links in emails)
APP_URL = "https://easy-job-gpt.streamlit.app"

# Optional sources
RELIEFWEB_APPNAME = ""   # request at https://apidoc.reliefweb.int/parameters#appname
ADZUNA_APP_ID = ""       # https://developer.adzuna.com
ADZUNA_APP_KEY = ""
JOOBLE_KEY = ""          # https://jooble.org/api/about
